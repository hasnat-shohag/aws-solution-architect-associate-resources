---
import terms from '../../content/glossary-terms.json';

interface GlossaryEntry {
	term: string;
	bn: string;
	tip: string;
	theme: string;
}

	const sorted = (terms as GlossaryEntry[]).sort((a, b) => a.term.localeCompare(b.term));
---

<div class="glossary-toolbar">
	<div class="glossary-filters" data-glossary-filters>
		<button type="button" data-glossary-theme="all" aria-pressed="true">সব</button>
		{
			[...new Set((terms as GlossaryEntry[]).map((entry) => entry.theme))].map((theme) => (
				<button type="button" data-glossary-theme={theme} aria-pressed="false">
					{theme}
				</button>
			))
		}
	</div>

	<label class="glossary-search">
		<span>শব্দ খুঁজুন</span>
		<input type="search" data-glossary-search placeholder="যেমন: DynamoDB, RTO, gRPC" autocomplete="off" />
	</label>
</div>

<p class="progress-hint" data-glossary-count>
	{sorted.length}টি শব্দ দেখানো হচ্ছে
</p>

<div class="table-scroll">
	<table class="keyword-table">
		<thead>
			<tr>
				<th scope="col">শব্দ (English)</th>
				<th scope="col">বাংলা অর্থ</th>
				<th scope="col">পরীক্ষার টিপ</th>
				<th scope="col">থিম</th>
			</tr>
		</thead>
		<tbody>
			{
				sorted.map((entry) => (
					<tr
						data-glossary-row
						data-theme={entry.theme}
						data-search={`${entry.term} ${entry.bn} ${entry.tip}`.toLowerCase()}
					>
						<td class="keyword-term">{entry.term}</td>
						<td>{entry.bn}</td>
						<td>{entry.tip}</td>
						<td>{entry.theme}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<p class="glossary-empty" data-glossary-empty hidden>
	কোনো শব্দ মেলেনি — বানান দেখে নিন বা অন্য থিম বেছে নিন।
</p>

<script>
	const filters = document.querySelector<HTMLElement>('[data-glossary-filters]');
	const search = document.querySelector<HTMLInputElement>('[data-glossary-search]');
	const count = document.querySelector<HTMLElement>('[data-glossary-count]');
	const empty = document.querySelector<HTMLElement>('[data-glossary-empty]');
	const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-glossary-row]'));
	let activeTheme = 'all';

	function apply(): void {
		const query = search?.value.trim().toLowerCase() ?? '';
		let visible = 0;
		rows.forEach((row) => {
			const matchesTheme = activeTheme === 'all' || row.dataset.theme === activeTheme;
			const matchesQuery = query.length === 0 || (row.dataset.search ?? '').includes(query);
			const show = matchesTheme && matchesQuery;
			row.hidden = !show;
			if (show) visible += 1;
		});
		if (count) count.textContent = `${visible}টি শব্দ দেখানো হচ্ছে`;
		if (empty) empty.hidden = visible !== 0;
	}

	filters?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-glossary-theme]');
		if (!button) return;
		activeTheme = button.dataset.glossaryTheme ?? 'all';
		filters
			.querySelectorAll<HTMLButtonElement>('[data-glossary-theme]')
			.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
		apply();
	});

	search?.addEventListener('input', apply);
	apply();
</script>
