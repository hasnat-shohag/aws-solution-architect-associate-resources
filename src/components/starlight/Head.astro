---
import Default from '@astrojs/starlight/components/Head.astro';

const frontmatter = Astro.locals.starlightRoute.entry?.data as { theme?: string } | undefined;
const theme = typeof frontmatter?.theme === 'string' ? frontmatter.theme : undefined;
---

<Default />

{
	theme !== undefined && (
		<script is:inline define:vars={{ theme }}>
			document.documentElement.dataset.themeRoot = String(theme);
		</script>
	)
}

<script is:inline>
	/* ---- preview mode badge ---- */
	document.addEventListener('astro:after-frontmatter', () => {
		applyPreviewBadge();
	});
  function applyPreviewBadge() {
		if (document.querySelector('.saa-preview-badge')) return;
		const sidebar = document.querySelector('.sl-sidebar');
		if (!sidebar) return;
		const badge = document.createElement('p');
		badge.className = 'saa-preview-badge';
		badge.innerHTML =
			'<span class="saa-preview-dot"></span> Preview — v0.1.0 · কনটেন্ট ধাপে ধাপে যোগ হচ্ছে';
		sidebar.insertBefore(badge, sidebar.firstChild);
	}
	applyPreviewBadge();
</script>

<script>
	import { LESSON_EVENT, loadState, isComplete } from '../../lib/progress';

	/* ---- sidebar completion marks ---- */

	function paintSidebar(): void {
		const state = loadState();
		document.querySelectorAll<HTMLAnchorElement>('a[data-lesson-id]').forEach((link) => {
			const id = link.dataset.lessonId;
			if (!id) return;
			link.classList.toggle('is-complete', isComplete(state, id));
		});
	}

	paintSidebar();
	window.addEventListener(LESSON_EVENT, paintSidebar);
	document.addEventListener('astro:page-load', paintSidebar);

	/* ---- lazy mermaid rendering for ```mermaid blocks ---- */

	const mermaidBlocks = Array.from(
		document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"], pre > code.language-mermaid'),
	).map((node) => {
		const pre = (node.tagName === 'PRE' ? node : node.parentElement) as HTMLElement;
		const frame = pre.closest<HTMLElement>('figure.frame');
		return {
			code: pre.querySelector('code') ?? pre,
			target: frame ?? pre,
		};
	});

	if (mermaidBlocks.length > 0) {
		void renderMermaid(mermaidBlocks);
	}

	async function renderMermaid(
		entries: { code: HTMLElement; target: HTMLElement }[],
		attempt = 0,
	): Promise<void> {
		try {
			const { default: mermaid } = await import('mermaid');
			const isDark = document.documentElement.dataset.theme === 'dark';
			mermaid.initialize({
				startOnLoad: false,
				securityLevel: 'strict',
				theme: isDark ? 'dark' : 'default',
				fontFamily: 'inherit',
			});

			const sources: { figure: HTMLElement; source: string }[] = [];

			for (const [index, entry] of entries.entries()) {
				const source = (entry.code.innerText || entry.code.textContent || '').trim();
				const figure = document.createElement('figure');
				figure.className = 'mermaid-figure';
				try {
					const { svg } = await mermaid.render(`saa-aws-mermaid-${index}`, source);
					figure.innerHTML = svg;
					entry.target.replaceWith(figure);
					sources.push({ figure, source });
				} catch (error) {
					console.warn('[saa-aws] mermaid render failed', error);
				}
			}

			const themeWatcher = new MutationObserver(() => {
				const dark = document.documentElement.dataset.theme === 'dark';
				mermaid.initialize({
					startOnLoad: false,
					securityLevel: 'strict',
					theme: dark ? 'dark' : 'default',
					fontFamily: 'inherit',
				});
				sources.forEach(({ figure, source }, index) => {
					void mermaid
						.render(`saa-aws-mermaid-theme-${index}-${Date.now()}`, source)
						.then(({ svg }) => {
							figure.innerHTML = svg;
						})
						.catch(() => undefined);
				});
			});
			themeWatcher.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['data-theme'],
			});
		} catch (error) {
			if (attempt < 1) {
				await new Promise((resolve) => setTimeout(resolve, 400));
				return renderMermaid(entries, attempt + 1);
			}
			console.warn('[saa-aws] mermaid unavailable', error);
		}
	}
</script>
